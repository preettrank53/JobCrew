GROQ_API_KEY="" # For Groq LLM inference (llama-3.3-70b-versatile)
USAJOBS_API_KEY="" # For fetching live job listings
USAJOBS_USER_AGENT="" # Required header for USAJobs API (use email format)

# Pipeline Configuration
PIPELINE_MODE="standard" # "standard" or "fast" — fast uses lower token limits
MAX_AGENT_ITERATIONS=3 # Max reasoning loops per agent (lower = faster)
MAX_AGENT_RPM=10 # Max requests per minute to LLM provider
PIPELINE_TIMEOUT_SECONDS=180 # Max seconds before pipeline is killed
GROQ_TEMPERATURE=0.3 # LLM creativity (0.0 = deterministic, 1.0 = creative)
