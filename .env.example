# ==============================================================================
# LLM Providers Settings
# ==============================================================================
# Groq API Key for fast inference (Llama-3 models)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Google GenAI)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key for alternative model routing (optional fallback)
# Get yours at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ==============================================================================
# Observability & Monitoring Settings
# ==============================================================================
# LangSmith Tracing configurations
# Get your API key at: https://smith.langchain.com/
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=jobcrew-v2
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Sentry DSN for error tracking
# Get yours at: https://sentry.io/
SENTRY_DSN=your_sentry_dsn_here

# ==============================================================================
# Job Sources Settings
# ==============================================================================
# Adzuna API credentials
# Get yours at: https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# USAJobs Developer API credentials
# Get yours at: https://developer.usajobs.gov/
USAJOBS_API_KEY=your_usajobs_api_key_here
USAJOBS_USER_AGENT=your_email@example.com

# ==============================================================================
# Database Settings
# ==============================================================================
# Supabase project URL and service/anon key
# Get yours at: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key_here

# ==============================================================================
# Application Configuration
# ==============================================================================
# Current deployment environment (development, staging, production)
ENVIRONMENT=development

# Pipeline version identifier
PIPELINE_VERSION=2.0.0

# Timeout for external HTTP requests in seconds
REQUEST_TIMEOUT=30.0

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
